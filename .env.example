# Copy to .env and fill in. .env is gitignored and must never be committed.
# WP §10.1: secrets live in a server-side .env outside the repository.

# ---------------------------------------------------------------------------
# Database — Supabase (managed Postgres)
# ---------------------------------------------------------------------------
# Supabase dashboard -> Project Settings -> Database -> Connection string -> URI.
# Use the SESSION POOLER (port 5432) connection string, not the transaction
# pooler (6543): the transaction pooler does not support prepared statements or
# session-level features the migration runner relies on.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3000

# Signing secret for the session cookie. Generate a fresh one per environment:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# How long a login lasts.
SESSION_TTL_HOURS=12

# Set to true ONLY when served over HTTPS — it sets the Secure flag on the
# session cookie, and a Secure cookie is silently dropped over plain HTTP.
# There is no domain/TLS on this deployment yet, so it stays false for now.
COOKIE_SECURE=false

# Comma-separated allowed origins for the browser front end. Empty = same-origin
# only, which is what the Nginx setup does (API and static assets same host).
CORS_ORIGINS=

# ---------------------------------------------------------------------------
# Language
# ---------------------------------------------------------------------------
# Language for all user-facing messages: en | he.
#
# Both translations always ship (src/lib/messages.ts), so this is a one-line
# switch, not a rewrite. Development runs 'en' so the developer can read the
# output; the end users at Izzy Yogev are Hebrew-speaking, so PRODUCTION MUST
# BE SET TO he BEFORE GO-LIVE.
#
# API responses always include a stable machine-readable `error` code alongside
# the translated message, so clients never depend on the text.
#
# Changing this requires a restart.
UI_LANG=en

# ---------------------------------------------------------------------------
# Outbound email — self-service password reset
# ---------------------------------------------------------------------------
# All five SMTP_* values plus APP_BASE_URL must be set for the "forgot
# password" email flow to switch on. While any are missing the login screen
# shows "contact your system administrator" instead, and nothing else changes.
#
# Production uses Brevo's free SMTP relay (300 emails/day):
#   Brevo dashboard -> SMTP & API -> SMTP -> generate an SMTP key.
#   SMTP_HOST=smtp-relay.brevo.com  SMTP_PORT=587
#   SMTP_USER=<the Brevo account login shown on that page>
#   SMTP_PASS=<the generated SMTP key>
#   SMTP_FROM must be a sender VERIFIED in Brevo (Senders & Domains).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Public origin the emailed reset links point at — no trailing slash.
APP_BASE_URL=https://srv1859122.hstgr.cloud
