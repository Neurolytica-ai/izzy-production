{
  "name": "izy-production",
  "version": "0.1.0",
  "private": true,
  "description": "Izzy Yogev Technologies — Production Management & Control System",
  "type": "module",
  "engines": {
    "node": ">=22.14.0 <23"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "smoke": "tsx scripts/smoke.ts",
    "migrate": "tsx scripts/migrate.ts",
    "schema:verify": "tsx scripts/verify-schema.ts",
    "verify:live": "tsx scripts/verify-live.ts",
    "verify:api": "tsx scripts/verify-api.ts",
    "user:create": "tsx scripts/create-user.ts",
    "seed:extract": "tsx scripts/extract-seed.ts",
    "seed:load": "tsx scripts/load-seed.ts",
    "css:extract": "tsx scripts/extract-css.ts",
    "web:dev": "vite",
    "web:build": "vite build",
    "typecheck:web": "tsc -p web/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.4",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "pg": "^8.14.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.1",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.13.14",
    "@types/pg": "^8.11.11",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vite": "^6.4.3"
  }
}
