# Production .env template for the server (srv1859122.hstgr.cloud).
#
# On the server:  cp .env.production.example .env  then fill in the two secrets.
# .env is gitignored and must never be committed. (WP §10.1)
#
# What differs from development is called out inline.

# ---------------------------------------------------------------------------
# Database — Supabase (managed Postgres) — SAME project as development
# ---------------------------------------------------------------------------
# The schema and seed are already deployed to this project, so there is nothing
# to migrate on first boot. Use the SESSION POOLER (port 5432) URI, not the
# transaction pooler (6543).
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NODE_ENV=production
PORT=3000

# Generate a FRESH secret for production (do not reuse the dev one):
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

SESSION_TTL_HOURS=12

# TRUE in production: the site is served over HTTPS, so the session cookie must
# carry the Secure flag. (Set this only once TLS is actually live — a Secure
# cookie is dropped over plain HTTP, which silently breaks login. During the
# HTTP-only bootstrap step keep it false, then flip it to true with TLS.)
COOKIE_SECURE=true

# Same-origin only (nginx serves the API and the front end on one host).
CORS_ORIGINS=

# ---------------------------------------------------------------------------
# Language — PRODUCTION IS HEBREW
# ---------------------------------------------------------------------------
# Both translations ship in the build; this is the one-line switch to the
# Hebrew interface the Izzy Yogev users need. Requires a restart to change.
UI_LANG=he
