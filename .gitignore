node_modules/
dist/

# Front-end build output, served by Nginx as the site root. Generated by
# `npm run web:build` and by the Docker build — not committed.
public/

# Secrets — WP §10.1. Never commit these.
.env
.env.*
!.env.example
!.env.production.example
*.pem
*.key

# The live-selected nginx config (copied from default.conf or https.conf during
# deploy). Kept out of git so the two templates stay the source of truth and a
# server-side switch never shows up as a repo change.
nginx/active.conf

# Local artifacts
*.log
npm-debug.log*
.DS_Store
Thumbs.db
coverage/
.vscode/
.idea/

# Uploaded Excel files staged for import (Phase 3)
uploads/
tmp/
